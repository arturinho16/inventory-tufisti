# PostgreSQL. Usa una contraseña larga sin espacios y codifica caracteres
# reservados antes de incluirlos dentro de DATABASE_URL.
POSTGRES_DB=tufis
POSTGRES_USER=tufis
POSTGRES_PASSWORD=cambia-esta-contrasena
DATABASE_URL=postgresql://tufis:cambia-esta-contrasena@base-datos:5432/tufis

# Puerto de la aplicación accesible desde el equipo de Nginx Proxy Manager.
# Si el servidor tiene varias interfaces, sustituye 0.0.0.0 por su IP LAN.
TUFIS_BIND_ADDRESS=0.0.0.0
TUFIS_PORT=3000

# Protege la descarga y restauración del inventario mientras no existan usuarios.
RESPALDOS_ADMIN_KEY=
# Token independiente usado solamente entre el programador Docker y TUFIS.
RESPALDOS_CRON_TOKEN=

# Análisis opcional de fichas técnicas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Proveedor FTF con Scrapling. El valor 0 no impone espera desde TUFIS;
# puedes definir un intervalo si posteriormente decides limitar el ritmo.
FTF_REQUEST_INTERVAL_SECONDS=120
FTF_MAX_RETRIES=2
FTF_RETRY_BASE_SECONDS=1
FTF_MAX_CANDIDATES=5
# Token largo y distinto de los demás secretos internos.
FTF_WORKER_TOKEN=

# Integración con Mercado Libre. No confirmes secretos en Git.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://360core.tufisti.net/api/mercadolibre/callback
# Clave Base64 de 32 bytes; se usará para cifrar tokens en PostgreSQL.
MERCADOLIBRE_TOKEN_ENCRYPTION_KEY=
